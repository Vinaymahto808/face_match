# Copy to `.env`. All settings are read from the environment with no prefix.

# --- App -------------------------------------------------------------------
APP_NAME=face-attendance-api
ENVIRONMENT=dev
DEBUG=false
API_PREFIX=/api/v1

# Comma separated. Use explicit origins in prod, never "*".
CORS_ORIGINS=*

# --- Database --------------------------------------------------------------
# Relative sqlite path is resolved against the project root.
DATABASE_URL=sqlite:///./data/attendance.db
DB_ECHO=false

# Business timezone used to decide "which day" an attendance punch belongs to.
BUSINESS_TIMEZONE=Asia/Kolkata

# --- Ingest limits ---------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_FRAME_EDGE=1280

# --- Face recognition ------------------------------------------------------
# deepface | stub   ("stub" is a deterministic no-op model for local dev/tests.
# It is hard-blocked from writing attendance unless ALLOW_STUB_BACKEND=true.)
EMBEDDING_BACKEND=deepface
FACE_MODEL_NAME=Facenet
FACE_DETECTOR=opencv
# Escape hatch for the line above. While false, a punch attempted with the stub
# backend is refused even if everything else checks out. Only ever true in dev
# or CI.
ALLOW_STUB_BACKEND=false
# Cosine distance. DeepFace's Facenet reference threshold is 0.40.
MATCH_THRESHOLD=0.40
# Distances between MATCH_THRESHOLD and MATCH_THRESHOLD*factor are returned as
# "review" instead of "unknown", so borderline cases get human attention.
MATCH_GRAY_ZONE_FACTOR=1.25

# --- Anti-spoofing / liveness ---------------------------------------------
# When true, an attendance punch MUST carry a passed, unconsumed
# liveness_session_id *for the same person the verification named*, and a
# single-use verification_id. There is no way to punch attendance without them.
REQUIRE_LIVENESS=true
# Weighted score from passive single-frame texture/colour analysis, 0..1.
PASSIVE_LIVENESS_MIN=0.55
# How many DISTINCT challenge types must be passed (order is randomised per
# session and each challenge has a randomised reveal time, so a pre-recorded
# montage of challenge clips cannot satisfy the sequence).
ACTIVE_LIVENESS_MIN_CHALLENGES=2
# Comma separated challenge pool.
LIVENESS_CHALLENGES=blink,head_turn_left,head_turn_right,move_closer
LIVENESS_SESSION_TTL_SECONDS=90
LIVENESS_MAX_ATTEMPTS=3
LIVENESS_LOCKOUT_SECONDS=300
# Optional ONNX mini-FASNet (1.8 MB) for a CNN spoof score fused with the
# passive heuristics. Left blank, the pure-numpy heuristics are used.
LIVENESS_FASNET_MODEL=

# --- Identity proof --------------------------------------------------------
# How long /recognition/verify's `verification_id` stays spendable. It carries
# the match distance the server measured and names the user, so it is the only
# thing that can authorise a punch. Long enough for a person to finish a
# challenge after being recognised, short enough that a frame captured this
# morning cannot authorise a punch this afternoon.
VERIFICATION_TTL_SECONDS=120

# --- Security --------------------------------------------------------------
# Comma separated API keys. Empty = no auth (dev only). Enforced on every route
# except the /health probes, and on the WebSocket handshake.
API_KEYS=
RATE_LIMIT_PER_MINUTE=120
# Rate-limit buckets are keyed on the socket peer address. Leave this false
# unless a proxy in front of the app is known to OVERWRITE X-Forwarded-For --
# the header is client-writable, so trusting it by default lets an
# unauthenticated caller mint a fresh bucket per request by rotating it.
TRUST_PROXY_HEADERS=false

# --- Alerting --------------------------------------------------------------
# Every spoof/liveness failure is written to the `events` table AND POSTed here
# as JSON if set. Point it at Slack/email/your incident tooling.
# Must be http:// or https:// -- any other scheme fails the boot, because this
# value is handed to urllib.request.urlopen unfiltered.
ALERT_WEBHOOK_URL=
